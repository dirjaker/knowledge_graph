# ============================================================
# 知识图谱平台环境变量配置模板
# 复制此文件为 .env 后填入真实值：
#   cp .env.example .env
# ============================================================

# LLM API Key（必填，会覆盖 data/config.json 中的 api_key）
LLM_API_KEY=sk-your-deepseek-api-key-here

# （可选）其他配置可直接修改 data/config.json
